# Copy to .env and fill in. Never paste keys into chat.
#   copy .env.example .env

# --- TensorMux (everyday brain) ---
# OpenAI-compatible. Actor / Reflect / Patch default here.
# Do not use TensorMux for embeddings.
TMX_API_KEY=
TENSOR_MUX_BASE_URL=https://api.tensormux.com/v1
TENSOR_MUX_MODEL=glm-4-7-flash

# --- Trace SoR (verified: docs.neatlogs.com/sdk/http-injection) ---
# Dashboard (keys, cockpit): https://app.neatlogs.com
# Ingest only:               https://ingest.neatlogs.com
# POST /v1/trace
# Auth: Authorization: Bearer <write key nlw_…>   (not x-api-key)
# Root JSON field "project" is the project NAME.
# Do not POST to app.neatlogs.com or api.neatlogs.com.
NEATLOGS_API_KEY=
NEATLOGS_PROJECT_ID=journeyman
NEATLOGS_BASE_URL=https://ingest.neatlogs.com

# --- AI Grants OpenAI (escalator + embeddings only) ---
# gpt-5-nano when TensorMux fails a quality gate on Reflect, Patch, or a hard Actor step.
# text-embedding-3-small for playbook RAG (ada-002 backup).
# Docs: aigrants. Do not put keys in chat.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_ESCALATE_MODEL=gpt-5-nano
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_FALLBACK=text-embedding-ada-002

# --- GitHub MCP (already pinned) ---
GITHUB_TOKEN=
GH_TOKEN=

# --- Smallest.ai (voice later; key name is SMALLEST_API_KEY) ---
SMALLEST_API_KEY=

# --- skipped v1 ---
# DODO_API_KEY=
